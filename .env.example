# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ---- Backend (apps/backend, Cloudflare Worker) ----
# Postgres connection string. The default driver is @neondatabase/serverless,
# which expects a Neon-compatible endpoint.
POSTGRES_URL="postgres://user:password@host/dbname"

# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Preconfigured Discord OAuth provider, works out-of-the-box
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# Where the web frontend is served from. Used for CORS + Better Auth trustedOrigins.
FRONTEND_URL='http://localhost:3001'
# Public URL of the backend in production. Used by Better Auth's oAuthProxy plugin.
PRODUCTION_URL='http://localhost:8787'

# ---- Frontend (apps/frontend) ----
# URL the frontend uses to reach the backend. VITE_BACKEND_URL is bundled into
# the browser; BACKEND_URL is used during SSR.
BACKEND_URL='http://localhost:8787'
VITE_BACKEND_URL='http://localhost:8787'
